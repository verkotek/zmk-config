#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <130>;
};

/ {
    combos {
        compatible = "zmk,combos";

        zapata {
            timeout-ms = <100>;
            bindings = <&kp COMMA>;
            key-positions = <16 32>;
        };

        backslash {
            timeout-ms = <100>;
            bindings = <&kp BACKSLASH>;
            key-positions = <16 33>;
        };

        apos {
            timeout-ms = <100>;
            bindings = <&kp APOS>;
            key-positions = <16 22>;
        };

        box_r {
            timeout-ms = <100>;
            bindings = <&kp LBKT>;
            key-positions = <16 9>;
        };

        box_l {
            timeout-ms = <100>;
            bindings = <&kp RBKT>;
            key-positions = <16 10>;
        };

        Layer3 {
            bindings = <&tog 3>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        start {
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R         &kp T        &kp Y      &kp U  &kp I    &kp O      &kp P      &sk LEFT_SHIFT
&kp LEFT_SHIFT  &kp A  &kp S  &kp D         &kp F         &kp G        &kp H      &kp J  &kp K    &kp L      &kp SEMI   &kp BACKSPACE
&kp LCTRL       &kp Z  &kp X  &kp C         &kp V         &kp B        &kp N      &kp M  &kp DOT  &kp SLASH  &kp GRAVE  &kp ESC
                              &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE    &kp ENTER  &mo 1  &mo 2
            >;
        };

        low {
            bindings = <
&trans  &kp N1              &kp N2     &kp N3     &kp N4     &kp N5             &mt SLASH ASTERISK   &mt MINUS PLUS    &mt POUND PERCENT    &mt DOLLAR CARET  &mt EXCLAMATION EQUAL  &mt AMPERSAND PIPE
&trans  &kp N6              &kp N7     &kp N8     &kp N9     &kp N0             &kp LEFT             &kp DOWN          &kp UP               &kp RIGHT         &msc MOVE_Y(20)        &kp DELETE
&trans  &msc (MOVE_X(-15))  &mkp RCLK  &mkp LCLK  &mkp LCLK  &msc MOVE_X(15)    &mmv (MOVE_X(-400))  &mmv MOVE_Y(400)  &mmv (MOVE_Y(-400))  &mmv MOVE_X(400)  &msc (MOVE_Y(-20))     &trans
                                       &trans     &trans     &kp UNDERSCORE     &trans               &trans            &trans
            >;
        };

        top {
            bindings = <
&bt BT_CLR  &kp C_PLAY_PAUSE   &kp KP_N7  &kp KP_N8  &kp KP_N9  &mt RIGHT_BRACKET LEFT_BRACKET            &kp F1    &kp F2           &kp F3   &kp F4   &kp F5   &kp PRINTSCREEN
&trans      &kp C_VOLUME_UP    &kp KP_N4  &kp KP_N5  &kp KP_N6  &mt RIGHT_BRACE LEFT_BRACE                &kp F6    &kp F7           &kp F8   &kp F9   &kp F10  &kp C_MUTE
&trans      &kp C_VOLUME_DOWN  &kp KP_N1  &kp KP_N2  &kp KP_N3  &mt RIGHT_PARENTHESIS LEFT_PARENTHESIS    &kp HOME  &mt PG_DN PG_UP  &kp END  &kp F11  &kp F12  &trans
                                          &trans     &trans     &kp KP_N0                                 &trans    &trans           &trans
            >;
        };

        numbers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &mo 1   &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
